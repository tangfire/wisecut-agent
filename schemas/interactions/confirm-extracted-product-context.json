{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisecut-agent/schemas/interactions/confirm-extracted-product-context.json",
  "title": "confirm_extracted_product_context",
  "description": "Interaction card for confirming extracted product information.",
  "type": "object",
  "required": ["intent", "status", "frontend_interaction"],
  "properties": {
    "intent": { "type": "string", "const": "confirm_extracted_product_context" },
    "status": {
      "type": "string",
      "enum": ["pending", "answered", "cancelled"]
    },
    "frontend_interaction": {
      "type": "object",
      "required": ["intent", "status"],
      "properties": {
        "intent": { "type": "string", "const": "confirm_extracted_product_context" },
        "status": {
          "type": "string",
          "enum": ["pending", "answered", "cancelled"]
        },
        "product_name": { "type": "string" },
        "product_description": { "type": "string" },
        "selling_points": {
          "type": "array",
          "items": { "type": "string" }
        },
        "target_audience": {
          "type": "array",
          "items": { "type": "string" }
        },
        "product_type": { "type": "string" },
        "actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cards": { "type": "array", "items": { "type": "object" } },
        "options": { "type": "array", "items": { "type": "object" } },
        "value": {},
        "message": { "type": "string" }
      }
    }
  }
}
