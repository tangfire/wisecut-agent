{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisecut-agent/schemas/events/interaction-resolved.json",
  "title": "interaction.resolved",
  "description": "Emitted when an interaction receives a user answer.",
  "type": "object",
  "required": ["seq", "type", "payload"],
  "properties": {
    "seq": { "type": "integer", "minimum": 0 },
    "type": { "type": "string", "const": "interaction.resolved" },
    "payload": {
      "type": "object",
      "required": ["interaction_id", "run_id", "action"],
      "properties": {
        "interaction_id": { "type": "string" },
        "run_id": { "type": "string" },
        "action": {
          "type": "string",
          "enum": ["approve", "deny", "submit", "cancel", "ai_decide"]
        },
        "status": {
          "type": "string",
          "enum": ["answered", "cancelled"]
        },
        "value": {
          "oneOf": [
            { "type": "object" },
            { "type": "array" },
            { "type": "string" }
          ]
        },
        "client_action_id": { "type": "string" },
        "resolved_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
