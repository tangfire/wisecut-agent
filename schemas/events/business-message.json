{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisecut-agent/schemas/events/business-message.json",
  "title": "business.message",
  "description": "Emitted for business-level notifications consumed by the Go Consumer.",
  "type": "object",
  "required": ["seq", "type", "payload"],
  "properties": {
    "seq": { "type": "integer", "minimum": 0 },
    "type": { "type": "string", "const": "business.message" },
    "payload": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": {
          "type": "object",
          "required": ["business_key", "status"],
          "properties": {
            "business_key": {
              "type": "string",
              "description": "Business message key (e.g., final_video, product_context)."
            },
            "status": {
              "type": "string",
              "enum": ["completed", "failed", "in_progress"]
            },
            "payload": {
              "type": "object",
              "description": "Business payload. Structure varies by business_key.",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
