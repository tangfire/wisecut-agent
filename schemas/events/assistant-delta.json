{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisecut-agent/schemas/events/assistant-delta.json",
  "title": "assistant.delta",
  "description": "Streaming text delta from the assistant.",
  "type": "object",
  "required": ["seq", "type", "payload"],
  "properties": {
    "seq": { "type": "integer", "minimum": 0 },
    "type": { "type": "string", "const": "assistant.delta" },
    "payload": {
      "type": "object",
      "required": ["content"],
      "properties": {
        "content": { "type": "string" },
        "message_id": { "type": "string" }
      }
    }
  }
}
