# WiseCut MAA Agent Environment Configuration
# Copy to .env and fill in real values for your environment.

# ------------------------------------------------------------------
# Environment (local-demo | local-llm | staging | production)
# ------------------------------------------------------------------
APP_ENV=local-demo

# ------------------------------------------------------------------
# Service
# ------------------------------------------------------------------
SERVICE_NAME=wisecut-agent
VERSION=0.1.0
PORT=10728
DEBUG=false

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# ------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://wisecut:wisecut@localhost:15432/wisecut_agent
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------
REDIS_URL=redis://:wisecut@localhost:16381/0
REDIS_LOCK_TTL_SECONDS=30

# ------------------------------------------------------------------
# RabbitMQ
# ------------------------------------------------------------------
RABBITMQ_URL=amqp://wisecut:wisecut@localhost:15676/
RABBITMQ_RUN_QUEUE=maa.run.commands
RABBITMQ_RETRY_QUEUE=maa.run.commands.retry
RABBITMQ_DLQ=maa.run.commands.dlq

# ------------------------------------------------------------------
# Object Storage (MinIO / S3)
# ------------------------------------------------------------------
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=<SECRET_260ae6c7>MINIO
S3_BUCKET=wisecut-agent
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# ------------------------------------------------------------------
# LLM Provider
# ------------------------------------------------------------------
# Set to "openai-compatible" to use a real LLM.
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ------------------------------------------------------------------
# Media Providers (demo | real)
# ------------------------------------------------------------------
MATERIAL_PROVIDER=demo
DIGITAL_HUMAN_PROVIDER=demo
VIDEO_RENDER_PROVIDER=demo

# ------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------
# MUST be false in production.
ENABLE_DEMO_PROVIDER=true
ENABLE_WORKER=true

# ------------------------------------------------------------------
# Security
# ------------------------------------------------------------------
# Optional API key for service-to-service auth.
API_KEY=
# CORS allowed origins (comma-separated).
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# ------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------
OTEL_EXPORTER_ENDPOINT=
OTEL_SERVICE_VERSION=0.1.0
